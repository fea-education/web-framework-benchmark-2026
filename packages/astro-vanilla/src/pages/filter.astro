---
import Layout from '../layouts/Layout.astro';
import type { Product, Category } from '@benchmark/data';
import { products as staticProducts } from '@benchmark/data';

const products: Product[] = staticProducts;

const categories: Category[] = [
  'Electronics', 'Clothing', 'Books', 'Home & Garden',
  'Sports', 'Toys', 'Food & Beverage', 'Beauty'
];

const prices = products.map((p) => p.price);
const minPrice = prices.length > 0 ? Math.floor(Math.min(...prices)) : 0;
const maxPrice = prices.length > 0 ? Math.ceil(Math.max(...prices)) : 1000;

const productsJson = JSON.stringify(products);
---

<Layout title="Filter Products">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-900">Filter Products</h1>
    <p class="text-neutral-500 mt-2">Filter by category, price, and rating</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Filter Sidebar -->
    <aside class="lg:col-span-1">
      <div class="bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-card)] p-6 sticky top-4">
        <h2 class="text-lg font-semibold text-neutral-900 mb-6">Filters</h2>

        <!-- Category Filter -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-neutral-700 mb-3 uppercase tracking-wide">Category</h3>
          <div class="space-y-2" id="category-filters">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" value="all" id="cat-all" checked class="w-4 h-4 text-brand-600 rounded" />
              <span class="text-sm text-neutral-700">All Categories</span>
            </label>
            {categories.map((cat) => (
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" value={cat} class="category-checkbox w-4 h-4 text-brand-600 rounded" />
                <span class="text-sm text-neutral-700">{cat}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Price Range Filter -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-neutral-700 mb-3 uppercase tracking-wide">Price Range</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <label class="text-xs text-neutral-500 w-8">Min</label>
              <input
                type="number"
                id="price-min"
                value={minPrice}
                min={minPrice}
                max={maxPrice}
                class="flex-1 text-sm border border-neutral-200 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-brand-500"
              />
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-neutral-500 w-8">Max</label>
              <input
                type="number"
                id="price-max"
                value={maxPrice}
                min={minPrice}
                max={maxPrice}
                class="flex-1 text-sm border border-neutral-200 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-brand-500"
              />
            </div>
          </div>
        </div>

        <!-- Rating Filter -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-neutral-700 mb-3 uppercase tracking-wide">Min Rating</h3>
          <div class="space-y-2">
            {[0, 1, 2, 3, 4].map((r) => (
              <label class="flex items-center gap-2 cursor-pointer">
                <input
                  type="radio"
                  name="rating"
                  value={r}
                  checked={r === 0}
                  class="w-4 h-4 text-brand-600"
                />
                <span class="text-sm text-neutral-700 flex items-center gap-1">
                  {r === 0 ? 'Any' : (
                    <>
                      {r}+
                      <svg class="w-3 h-3 text-warning inline" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    </>
                  )}
                </span>
              </label>
            ))}
          </div>
        </div>

        <button
          id="reset-filters"
          class="w-full px-4 py-2 text-sm font-medium text-neutral-600 border border-neutral-200 rounded-[var(--radius-button)] hover:bg-neutral-50 transition-colors"
        >
          Reset Filters
        </button>
      </div>
    </aside>

    <!-- Product Grid -->
    <div class="lg:col-span-3">
      <div id="results-count" class="text-sm text-neutral-500 mb-4">
        Showing <span id="count">{products.length}</span> products
      </div>
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Products rendered by JS -->
      </div>
      <div id="no-results" class="hidden text-center py-16">
        <p class="text-neutral-500 text-lg">No products match your filters.</p>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ productsJson, minPrice, maxPrice }}>
  // Type definitions for vanilla JS
  /** @type {Array<{id: number, name: string, price: number, category: string, rating: number, image_url: string, description: string, tags: string[], stock: number}>} */
  const allProducts = JSON.parse(productsJson);

  /** @type {string[]} */
  let selectedCategories = [];
  let currentMinPrice = minPrice;
  let currentMaxPrice = maxPrice;
  let minRating = 0;

  function renderProducts() {
    const filtered = allProducts.filter((p) => {
      const catOk = selectedCategories.length === 0 || selectedCategories.includes(p.category);
      const priceOk = p.price >= currentMinPrice && p.price <= currentMaxPrice;
      const ratingOk = p.rating >= minRating;
      return catOk && priceOk && ratingOk;
    });

    const grid = document.getElementById('product-grid');
    const noResults = document.getElementById('no-results');
    const countEl = document.getElementById('count');

    if (!grid || !noResults || !countEl) return;

    countEl.textContent = String(filtered.length);

    if (filtered.length === 0) {
      grid.innerHTML = '';
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
      grid.innerHTML = filtered.map((product) => `
        <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden">
          <a href="/products/${product.id}" class="block">
            <div class="aspect-square overflow-hidden bg-gray-100">
              <img
                src="${product.image_url}"
                alt="${product.name.replace(/"/g, '&quot;')}"
                width="400"
                height="300"
                loading="lazy"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-4">
              <span class="inline-block text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full mb-2">
                ${product.category}
              </span>
              <h2 class="text-sm font-semibold text-gray-900 line-clamp-2 mb-1">${product.name.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</h2>
              <div class="flex items-center justify-between mt-2">
                <span class="text-lg font-bold text-gray-900">$${product.price.toFixed(2)}</span>
                <span class="text-xs text-gray-500">★ ${product.rating.toFixed(1)}</span>
              </div>
            </div>
          </a>
        </article>
      `).join('');
    }
  }

  // Initial render
  renderProducts();

  // Category filter
  const catAllCheckbox = /** @type {HTMLInputElement|null} */ (document.getElementById('cat-all'));
  const categoryCheckboxes = /** @type {NodeListOf<HTMLInputElement>} */ (document.querySelectorAll('.category-checkbox'));

  catAllCheckbox?.addEventListener('change', () => {
    if (catAllCheckbox.checked) {
      categoryCheckboxes.forEach((cb) => { cb.checked = false; });
      selectedCategories = [];
      renderProducts();
    }
  });

  categoryCheckboxes.forEach((cb) => {
    cb.addEventListener('change', () => {
      if (catAllCheckbox) catAllCheckbox.checked = false;
      selectedCategories = Array.from(categoryCheckboxes)
        .filter((c) => c.checked)
        .map((c) => c.value);
      if (selectedCategories.length === 0 && catAllCheckbox) {
        catAllCheckbox.checked = true;
      }
      renderProducts();
    });
  });

  // Price filter
  const priceMinInput = /** @type {HTMLInputElement|null} */ (document.getElementById('price-min'));
  const priceMaxInput = /** @type {HTMLInputElement|null} */ (document.getElementById('price-max'));

  priceMinInput?.addEventListener('input', () => {
    currentMinPrice = Number(priceMinInput.value) || minPrice;
    renderProducts();
  });

  priceMaxInput?.addEventListener('input', () => {
    currentMaxPrice = Number(priceMaxInput.value) || maxPrice;
    renderProducts();
  });

  // Rating filter
  const ratingRadios = /** @type {NodeListOf<HTMLInputElement>} */ (document.querySelectorAll('input[name="rating"]'));
  ratingRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      minRating = Number(radio.value);
      renderProducts();
    });
  });

  // Reset filters
  document.getElementById('reset-filters')?.addEventListener('click', () => {
    selectedCategories = [];
    currentMinPrice = minPrice;
    currentMaxPrice = maxPrice;
    minRating = 0;

    if (catAllCheckbox) catAllCheckbox.checked = true;
    categoryCheckboxes.forEach((cb) => { cb.checked = false; });
    if (priceMinInput) priceMinInput.value = String(minPrice);
    if (priceMaxInput) priceMaxInput.value = String(maxPrice);
    ratingRadios.forEach((r) => { r.checked = r.value === '0'; });

    renderProducts();
  });
</script>
