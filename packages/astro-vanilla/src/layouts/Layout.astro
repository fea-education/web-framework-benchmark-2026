---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Web Framework Benchmark 2026 — Astro Vanilla' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Benchmark Shop</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-neutral-50 text-neutral-900 font-sans min-h-screen">
    <header class="bg-surface border-b border-neutral-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="text-xl font-bold text-brand-600 hover:text-brand-700 transition-colors">
            Benchmark Shop
          </a>
          <nav class="flex items-center gap-6">
            <a href="/" class="text-sm font-medium text-neutral-600 hover:text-brand-600 transition-colors">Products</a>
            <a href="/filter" class="text-sm font-medium text-neutral-600 hover:text-brand-600 transition-colors">Filter</a>
            <a href="/cart" class="text-sm font-medium text-neutral-600 hover:text-brand-600 transition-colors flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              Cart
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-neutral-200 bg-surface py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-sm text-neutral-500">Benchmark Shop — Astro Vanilla (Zero Framework JS)</p>
      </div>
    </footer>
  </body>
</html>
