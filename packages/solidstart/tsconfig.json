{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "outDir": ".output",
    "rootDir": ".",
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*", "app.config.ts"],
  "exclude": ["node_modules", ".output", ".vinxi"]
}
