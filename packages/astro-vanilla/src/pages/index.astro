---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import type { Product } from '@benchmark/data';
import { products as staticProducts } from '@benchmark/data';

const products: Product[] = staticProducts;
---

<Layout title="Products">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-900">All Products</h1>
    <p class="text-neutral-500 mt-2">{products.length} products available</p>
  </div>

  {products.length === 0 ? (
    <div class="text-center py-16">
      <p class="text-neutral-500 text-lg">No products found.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  )}
</Layout>
