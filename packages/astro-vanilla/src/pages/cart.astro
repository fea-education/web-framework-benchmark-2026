---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shopping Cart">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-900">Shopping Cart</h1>
  </div>

  <div id="cart-empty" class="hidden text-center py-16">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <h2 class="text-xl font-semibold text-neutral-700 mb-2">Your cart is empty</h2>
    <p class="text-neutral-500 mb-6">Add some products to get started.</p>
    <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 text-white font-semibold rounded-[var(--radius-button)] hover:bg-brand-700 transition-colors">
      Browse Products
    </a>
  </div>

  <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Cart Items -->
    <div class="lg:col-span-2">
      <div id="cart-items" class="space-y-4">
        <!-- Items rendered by JS -->
      </div>
    </div>

    <!-- Order Summary -->
    <div class="lg:col-span-1">
      <div class="bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-card)] p-6 sticky top-4">
        <h2 class="text-lg font-semibold text-neutral-900 mb-4">Order Summary</h2>
        <div class="space-y-3 mb-4">
          <div class="flex justify-between text-sm text-neutral-600">
            <span>Items (<span id="item-count">0</span>)</span>
            <span>$<span id="subtotal">0.00</span></span>
          </div>
          <div class="flex justify-between text-sm text-neutral-600">
            <span>Shipping</span>
            <span class="text-success">Free</span>
          </div>
        </div>
        <div class="border-t border-neutral-200 pt-4 mb-6">
          <div class="flex justify-between font-bold text-neutral-900">
            <span>Total</span>
            <span>$<span id="total">0.00</span></span>
          </div>
        </div>
        <button class="w-full px-6 py-3 bg-brand-600 text-white font-semibold rounded-[var(--radius-button)] hover:bg-brand-700 transition-colors">
          Checkout
        </button>
        <a href="/" class="block text-center mt-3 text-sm text-brand-600 hover:text-brand-700 transition-colors">
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface Product {
    id: number;
    name: string;
    price: number;
    image_url: string;
    category: string;
    rating: number;
    stock: number;
    description: string;
    tags: string[];
  }

  interface CartItem {
    product: Product;
    quantity: number;
  }

  function getCart(): CartItem[] {
    const stored = localStorage.getItem('cart');
    if (!stored) return [];
    try {
      return JSON.parse(stored) as CartItem[];
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]): void {
    localStorage.setItem('cart', JSON.stringify(cart));
  }

  function updateQuantity(productId: number, delta: number): void {
    const cart = getCart();
    const item = cart.find((i) => i.product.id === productId);
    if (!item) return;

    item.quantity += delta;
    if (item.quantity <= 0) {
      const idx = cart.indexOf(item);
      cart.splice(idx, 1);
    }
    saveCart(cart);
    renderCart();
  }

  function removeItem(productId: number): void {
    const cart = getCart().filter((i) => i.product.id !== productId);
    saveCart(cart);
    renderCart();
  }

  function renderCart(): void {
    const cart = getCart();
    const emptyEl = document.getElementById('cart-empty');
    const contentEl = document.getElementById('cart-content');
    const itemsEl = document.getElementById('cart-items');
    const itemCountEl = document.getElementById('item-count');
    const subtotalEl = document.getElementById('subtotal');
    const totalEl = document.getElementById('total');

    if (!emptyEl || !contentEl || !itemsEl) return;

    if (cart.length === 0) {
      emptyEl.classList.remove('hidden');
      contentEl.classList.add('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    contentEl.classList.remove('hidden');

    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const subtotal = cart.reduce((sum, item) => sum + item.product.price * item.quantity, 0);

    if (itemCountEl) itemCountEl.textContent = String(totalItems);
    if (subtotalEl) subtotalEl.textContent = subtotal.toFixed(2);
    if (totalEl) totalEl.textContent = subtotal.toFixed(2);

    itemsEl.innerHTML = cart.map((item) => `
      <article role="article" class="bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-card)] p-4 flex gap-4 items-center" data-product-id="${item.product.id}">
        <a href="/products/${item.product.id}" class="shrink-0">
          <img
            src="${item.product.image_url}"
            alt="${item.product.name.replace(/"/g, '&quot;')}"
            width="80"
            height="80"
            loading="lazy"
            class="w-20 h-20 object-cover rounded-lg bg-neutral-100"
          />
        </a>
        <div class="flex-1 min-w-0">
          <a href="/products/${item.product.id}" class="text-sm font-semibold text-neutral-900 hover:text-brand-600 transition-colors line-clamp-1">
            ${item.product.name.replace(/</g, '&lt;').replace(/>/g, '&gt;')}
          </a>
          <p class="text-xs text-neutral-500 mt-1">${item.product.category}</p>
          <p class="text-sm font-bold text-neutral-900 mt-2">$${(item.product.price * item.quantity).toFixed(2)}</p>
        </div>
        <div class="flex flex-col items-end gap-3 shrink-0">
          <button
            class="text-neutral-400 hover:text-danger transition-colors"
            onclick="window.__removeCartItem(${item.product.id})"
            aria-label="Remove"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <div class="flex items-center gap-2">
            <button
              class="w-8 h-8 flex items-center justify-center rounded-lg border border-neutral-200 hover:bg-neutral-100 transition-colors text-neutral-700"
              onclick="window.__updateCartQty(${item.product.id}, -1)"
              aria-label="Decrease quantity"
            >−</button>
            <span class="text-sm font-semibold text-neutral-900 w-6 text-center">${item.quantity}</span>
            <button
              class="w-8 h-8 flex items-center justify-center rounded-lg border border-neutral-200 hover:bg-neutral-100 transition-colors text-neutral-700"
              onclick="window.__updateCartQty(${item.product.id}, 1)"
              aria-label="Increase quantity"
            >+</button>
          </div>
        </div>
      </article>
    `).join('');
  }

  // Expose functions globally for inline onclick handlers
  (window as Window & typeof globalThis & {
    __updateCartQty: (id: number, delta: number) => void;
    __removeCartItem: (id: number) => void;
  }).__updateCartQty = updateQuantity;
  (window as Window & typeof globalThis & {
    __updateCartQty: (id: number, delta: number) => void;
    __removeCartItem: (id: number) => void;
  }).__removeCartItem = removeItem;

  // Initial render
  renderCart();

  // Listen for storage changes (cross-tab sync)
  window.addEventListener('storage', (e) => {
    if (e.key === 'cart') renderCart();
  });
</script>
