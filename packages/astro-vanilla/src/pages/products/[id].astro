---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { Product } from '@benchmark/data';
import { products as staticProducts } from '@benchmark/data';

export function getStaticPaths() {
  return staticProducts.map((product) => ({
    params: { id: String(product.id) },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<Layout title={product.name} description={product.description}>
  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Products
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Product Image -->
    <div class="aspect-square overflow-hidden rounded-[var(--radius-card)] bg-neutral-100 shadow-[var(--shadow-card)]">
      <Image
        src={product.image_url}
        alt={product.name}
        width={600}
        height={600}
        class="w-full h-full object-cover"
        inferSize={false}
      />
    </div>

    <!-- Product Info -->
    <div class="flex flex-col">
      <span class="inline-block text-sm font-medium text-brand-600 bg-brand-50 px-3 py-1 rounded-[var(--radius-badge)] mb-4 self-start">
        {product.category}
      </span>

      <h1 class="text-3xl font-bold text-neutral-900 mb-4">{product.name}</h1>

      <div class="flex items-center gap-3 mb-4">
        <div class="flex items-center gap-1">
          {Array.from({ length: 5 }, (_, i) => (
            <svg
              class={`w-5 h-5 ${i < Math.round(product.rating) ? 'text-warning' : 'text-neutral-300'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-neutral-600 text-sm">{product.rating.toFixed(1)} out of 5</span>
      </div>

      <p class="text-neutral-600 leading-relaxed mb-6">{product.description}</p>

      <div class="flex items-center gap-4 mb-6">
        <span class="text-4xl font-bold text-neutral-900">${product.price.toFixed(2)}</span>
        <span class={`text-sm font-medium px-3 py-1 rounded-[var(--radius-badge)] ${product.stock > 10 ? 'bg-green-100 text-green-700' : product.stock > 0 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}`}>
          {product.stock > 10 ? 'In Stock' : product.stock > 0 ? `Only ${product.stock} left` : 'Out of Stock'}
        </span>
      </div>

      {product.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {product.tags.map((tag) => (
            <span class="text-xs text-neutral-500 bg-neutral-100 px-2 py-1 rounded-[var(--radius-badge)]">{tag}</span>
          ))}
        </div>
      )}

      <button
        id="add-to-cart-btn"
        data-product={JSON.stringify(product)}
        class="w-full sm:w-auto px-8 py-3 bg-brand-600 text-white font-semibold rounded-[var(--radius-button)] hover:bg-brand-700 active:bg-brand-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        disabled={product.stock === 0}
      >
        {product.stock > 0 ? 'Add to Cart' : 'Out of Stock'}
      </button>

      <p id="cart-feedback" class="mt-3 text-sm text-success hidden">Added to cart!</p>
    </div>
  </div>
</Layout>

<script>
  const btn = document.getElementById('add-to-cart-btn');
  const feedback = document.getElementById('cart-feedback');

  btn?.addEventListener('click', () => {
    const productData = btn.dataset['product'];
    if (!productData) return;

    const product = JSON.parse(productData) as {
      id: number;
      name: string;
      price: number;
      image_url: string;
      category: string;
      rating: number;
      stock: number;
      description: string;
      tags: string[];
    };

    const stored = localStorage.getItem('cart');
    const cart: Array<{ product: typeof product; quantity: number }> = stored ? JSON.parse(stored) as Array<{ product: typeof product; quantity: number }> : [];

    const existing = cart.find((item) => item.product.id === product.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ product, quantity: 1 });
    }

    localStorage.setItem('cart', JSON.stringify(cart));

    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 2000);
    }
  });
</script>
